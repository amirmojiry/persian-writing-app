{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "persian-writing/api",
  "type": "project",
  "description": "Optional Laravel JSON API for the Persian Name Writing App.",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "laravel/tinker": "^2.10.1"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^3.7",
    "pestphp/pest-plugin-laravel": "^3.1"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "check": ["@php artisan test", "@php vendor/bin/phpstan analyse --memory-limit=1G"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
