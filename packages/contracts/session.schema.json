{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/writing-session.json",
  "title": "WritingSession",
  "type": "object",
  "required": ["id", "profileId", "status", "writingText", "uiLocale", "writingLanguage", "startedAt", "schemaVersion"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "profileId": { "type": "string", "format": "uuid" },
    "status": { "enum": ["draft", "active", "completed", "abandoned"] },
    "writingText": { "type": "string", "minLength": 1, "maxLength": 100 },
    "uiLocale": { "enum": ["fa", "en", "fi"] },
    "writingLanguage": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "settingsSnapshot": { "type": "object", "additionalProperties": true },
    "consentSnapshot": { "type": "object", "additionalProperties": { "type": "boolean" } }
  },
  "additionalProperties": false
}
